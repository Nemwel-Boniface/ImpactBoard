# ─── Upstash Redis ───────────────────────────────────────────
# Get these from: console.upstash.com → your database → REST API section
# Or from: Vercel Dashboard → your project → Settings → Environment Variables
# (auto-populated if you connected Upstash via Vercel Marketplace integration)
UPSTASH_REDIS_REST_URL=your_upstash_redis_rest_url_here
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token_here

